{
  "manifest_version": 3,
  "name": "Mirlo",
  "version": "0.1.0",
  "description": "Privacy-first language learning for intermediate learners. Read real content with instant, local translations. No tracking.",
  "action": {
    "default_title": "Mirlo",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/mirlo-16.png",
      "32": "assets/mirlo-32.png",
      "48": "assets/mirlo-48.png",
      "128": "assets/mirlo-128.png"
    }
  },
  "options_page": "options.html",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "assets/mirlo-16.png",
    "32": "assets/mirlo-32.png",
    "48": "assets/mirlo-48.png",
    "128": "assets/mirlo-128.png"
  },
  "permissions": ["activeTab", "storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
